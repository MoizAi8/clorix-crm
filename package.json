{
  "name": "clorix-crm",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:db": "node --env-file-if-exists=.env.local --import tsx --test tests/integration/*.test.ts",
    "test:e2e": "node --env-file-if-exists=.env.local scripts/browser-test.mjs",
    "benchmark": "node --env-file-if-exists=.env.local --import tsx scripts/benchmark.ts",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:admin": "node --env-file-if-exists=.env.local scripts/admin.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "better-auth": "1.7.28",
    "csv-parse": "7.0.3",
    "lucide-react": "0.487.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@playwright/test": "1.65.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
