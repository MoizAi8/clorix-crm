# Placeholder values only. Actual secrets go in ignored .env.local / secure deployment settings.
DATABASE_URL=
DIRECT_DATABASE_URL=
TEST_DATABASE_URL=
AUTH_SECRET=
APP_URL=http://localhost:3000
DEMO_RATE_LIMIT_SECRET=
PUBLIC_SANDBOX_ENABLED=true
# Apply the next three values with db:admin sandbox-policy. Keep onboarding copy in sync if TTL changes.
SANDBOX_TTL_HOURS=24
SANDBOX_MAX_ACTIVE=30
SANDBOX_IP_DAILY_LIMIT=12
SANDBOX_MAX_RECORDS=500
MAX_CSV_BYTES=262144
MAX_CSV_ROWS=200
MAX_EXPORT_ROWS=1000
# Confirm exact auth library env aliases at implementation. Never use NEXT_PUBLIC for secrets.
# DIRECT_DATABASE_URL is migration-only; do not include privileged role in runtime.
